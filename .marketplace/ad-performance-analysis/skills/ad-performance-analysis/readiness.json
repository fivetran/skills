{
  "metadata": {
    "app_id": "ad-performance-analysis",
    "name": "Ad Performance",
    "version": "1.0.0",
    "category": "marketing",
    "hero": "How are your ads actually performing?",
    "description": "Compare spend, ROAS, CPC, and CTR across your connected ad platforms from Fivetran-synced data, using each platform's reported numbers side by side.\n",
    "tags": [
      "ad spend",
      "ROAS",
      "CPC",
      "CTR",
      "cross-channel",
      "campaign performance",
      "marketing analytics"
    ],
    "preview_image": "assets/previews/ad_performance_preview.png"
  },
  "deployment": {
    "type": "skill",
    "skill_id": "ad-performance-analysis",
    "install": {
      "claude_code": {
        "marketplace": "fivetran/skills",
        "plugin": "ad-performance-analysis@fivetran-skills"
      }
    },
    "capabilities": [
      { "name": "Cross-Channel Comparison", "description": "Compare each platform's reported ROAS, CPC, and CTR side-by-side" },
      { "name": "Campaign Drill-Down", "description": "Break performance down by campaign, ad group, or individual ad" },
      { "name": "Trend Analysis", "description": "Spot week-over-week or month-over-month changes in spend and conversions" },
      { "name": "Anomaly Detection", "description": "Flag zero-conversion high-spend campaigns, CPC/CTR swings over 20%, and keyword budget concentration" },
      { "name": "Keyword & Search Analysis", "description": "Surface top-performing and wasteful search terms (where available)" }
    ],
    "example_questions": [
      "Which ad platform gave us the best ROAS last month?",
      "Compare Google Ads vs Facebook Ads spend and conversions for Q2",
      "Show me our top 10 keywords by conversion rate on Google Ads",
      "Which ad groups have a CPC above $5 but a conversion rate below 1%?",
      "Which campaigns spent over $1K last week with zero conversions?"
    ]
  },
  "scoping": {
    "require_same_destination": true
  },
  "connector_groups": [
    {
      "group_id": "ad_platform",
      "display_name": "Ad Platforms",
      "description": "At least one ad platform connector is required.",
      "min_required": 1,
      "options": [
        {
          "service": "google_ads",
          "display_name": "Google Ads",
          "required_tables": [
            { "name": "account_history" },
            { "name": "account_stats" },
            { "name": "campaign_history" },
            { "name": "campaign_stats" },
            { "name": "ad_group_history" },
            { "name": "ad_group_stats" },
            { "name": "ad_history" },
            { "name": "ad_stats" }
          ],
          "recommended_tables": [
            { "name": "keyword_stats" }
          ]
        },
        {
          "service": "facebook_ads",
          "display_name": "Facebook Ads",
          "required_tables": [
            { "name": "account_history" },
            { "name": "campaign_history" },
            { "name": "ad_set_history" },
            { "name": "ad_history" },
            { "name": "basic_ad" },
